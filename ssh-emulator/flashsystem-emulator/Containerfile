FROM python:3.11-slim

RUN apt-get update && apt-get install -y openssh-client && rm -rf /var/lib/apt/lists/*
RUN pip install asyncssh

RUN useradd -m -s /bin/bash admin && echo "admin:admin" | chpasswd
RUN mkdir -p /opt/mock/flash_commands /etc/ssh && ssh-keygen -A

WORKDIR /opt/mock
COPY flash_server.py ./
COPY commands/ ./flash_commands/

CMD ["python3", "flash_server.py"]
