#!/bin/sh
# If the wrapper passes the real command name as $1, use it; otherwise use the invoked name.
if [ "$#" -gt 0 ]; then
    CMD="$1"
    shift
else
    CMD="$(basename "$0")"
fi
ARGS="$*"
KEY="${CMD}"
if [ -n "$ARGS" ]; then
    KEY="${KEY} ${ARGS}"
fi
SAFE_KEY=$(echo "$KEY" | sed 's/[^A-Za-z0-9._-]/_/g')
FILE="/opt/mock/aix/data/${SAFE_KEY}.txt"

if [ -f "$FILE" ]; then
    cat "$FILE"
    exit 0
fi

echo "AIX-EMULATOR: command not implemented: $CMD $ARGS" >&2
exit 127
