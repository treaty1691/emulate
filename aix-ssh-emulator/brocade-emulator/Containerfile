FROM python:3.11-slim

RUN apt-get update && apt-get install -y openssh-client && rm -rf /var/lib/apt/lists/*
RUN pip install asyncssh

RUN useradd -m -s /bin/bash admin && echo "admin:admin" | chpasswd
RUN mkdir -p /opt/mock/brocade_commands /etc/ssh && ssh-keygen -A

WORKDIR /opt/mock
COPY brocade_server.py ./
COPY commands/ ./brocade_commands/

CMD ["python3", "brocade_server.py"]
